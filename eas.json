{
  "cli": {
    "version": ">= 10.0.0"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "preview",
        "FEATURE_GAMIFY": "true",
        "API_URL": "https://backendgias.onrender.com"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_VARIANT": "production",
        "FEATURE_GAMIFY": "true",
        "API_URL": "https://backendgias.onrender.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "serviceAccountKeyPath": "./.ci/google-service-key.json"
      }
    }
  }
}
