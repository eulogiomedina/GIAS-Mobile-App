    "expo": "54.0.21",
    "expo-auth-session": "~7.0.8",
    "expo-camera": "^17.0.8",
    "expo-constants": "~18.0.10",
    "expo-font": "14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-image-picker": "^17.0.8",
